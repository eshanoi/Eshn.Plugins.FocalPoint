<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Eshn.Plugins.FocalPoint</id>
    <version>3.0.0</version>
    <authors>ES Ha Noi</authors>
    <readme>README.md</readme>
    <license type="file">LICENSE</license>
    <projectUrl>https://github.com/eshanoi/Eshn.Plugins.FocalPoint</projectUrl>
    <description>This package supports user choose focal point of an image then cropping bases on it</description>
    <tags>Focal</tags>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Baaijte.Optimizely.ImageSharp.Web" version="[4.0.0, )" exclude="Build,Analyzers" />
		<dependency id="EPiServer.CMS.AspNetCore.HtmlHelpers" version="[13.1.2, )" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <contentFiles>
      <files include="any/any/modules/_protected/focal-point/focal-point.zip" buildAction="None" copyToOutput="true" />
    </contentFiles>
    <repository type="git" url="https://github.com/eshanoi/Eshn.Plugins.FocalPoint.git" branch="master" />
    <releaseNotes>
      - Upgrade to .net 10
    </releaseNotes>
  </metadata>
  <files>
    <file src="ClientResources\focal-point.zip" target="contentFiles\any\any\modules\_protected\focal-point\focal-point.zip" />
    <file src="bin\Release\net10.0\*.dll" target="lib\net10.0" />
    <file src="Eshn.Plugins.FocalPoint.targets" target="build\net10.0\" />
    <file src="..\LICENSE" target="LICENSE" />
    <file src="..\README.md" target="README.md" />
  </files>
</package>