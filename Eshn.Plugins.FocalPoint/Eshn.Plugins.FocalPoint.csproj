<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Eshn.Plugins.FocalPoint</RootNamespace>
        <PackageId>Eshn.Plugins.FocalPoint</PackageId>
        <Authors>ES HN</Authors>
        <AssemblyName>Eshn.Plugins.FocalPoint</AssemblyName>
        <LangVersion>11</LangVersion>
        <Company>ES HN</Company>
        <NuspecFile>Eshn.Plugins.FocalPoint.nuspec</NuspecFile>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <AssemblyVersion>3.0.0.0</AssemblyVersion>
        <FileVersion>3.0.0.0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
      <EmbeddedResource Include="Resources\FocalPointCropping.xml" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Baaijte.Optimizely.ImageSharp.Web" Version="4.0.0" />
      <PackageReference Include="EPiServer.CMS.AspNetCore" Version="13.1.2" />
      <PackageReference Include="EPiServer.CMS.AspNetCore.HtmlHelpers" Version="13.1.2" />
      <PackageReference Include="EPiServer.ImageLibrary.ImageSharp" Version="13.1.2" />
    </ItemGroup>
       
    <ItemGroup>
      <None Update="ClientResources\focal-point.zip">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>
       
    <ItemGroup>
      <None Remove="modules\_protected\focal-point\focal-point.zip" />
      <Content Include="modules\_protected\focal-point\focal-point.zip">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Eshn.Plugins.FocalPoint.targets" />
      <Content Include="Eshn.Plugins.FocalPoint.targets">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
       
    <ItemGroup>
      <None Include="..\README.md">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>
   

</Project>
